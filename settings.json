{
  "model": "claude-fable-5",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/block-admin-merge.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/block-force-push.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/block-hard-reset.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/pre-push-guard.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/pre-merge-check.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/pre-release-sweep.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/pre-commit-guard.sh",
            "timeout": 120
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/post-pr-create.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/context-monitor.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/docker-refresh.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-start-context.sh",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "tui": "fullscreen"
}
